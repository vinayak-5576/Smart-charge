      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;550;600;650;700&family=IBM+Plex+Mono:wght@400;500&display=swap');\n</style>\n<script src=\"https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js\">\n</script>\n<div class=\"bg-[#0b0f19] text-[#eff3fa] min-h-[940px] font-['Inter'] antialiased\" data-kid=\"1\">\n    <header class=\"px-5 lg:px-10 border-b border-[#283142] bg-[#101622]\" data-kid=\"1-1\">\n        <div class=\"flex justify-between items-center gap-5 min-h-20\" data-kid=\"1-1-1\">\n            <div class=\"flex items-center gap-2 text-[22px] font-semibold tracking-[-.7px]\" data-kid=\"1-1-1-1\">\n                <i class=\"w-6 h-6 text-[#66a2ff]\" data-kid=\"1-1-1-1-1\" data-lucide=\"zap\">\n                </i>\n                SmartCharge\n                <span class=\"hidden sm:block ml-4 pl-5 border-l border-[#344157] text-xs font-normal tracking-normal text-[#8b9db8]\" data-kid=\"1-1-1-1-2\">\n                    Grid planning console\n                </span>\n            </div>\n            <span class=\"text-[11px] text-[#93a6c2]\" data-kid=\"1-1-1-2\">\n                Baseline forecast\n            </span>\n        </div>\n        <nav aria-label=\"Main navigation\" class=\"flex flex-wrap gap-x-7 gap-y-3 text-xs text-[#8ea1bd]\" data-kid=\"1-1-2\">\n            <span class=\"flex items-center gap-2 pb-4 border-b-2 border-[#6aa4ff] text-[#d1e2ff]\" data-kid=\"1-1-2-1\">\n                <i class=\"w-4 h-4\" data-kid=\"1-1-2-1-1\" data-lucide=\"activity\">\n                </i>\n                Command Center\n            </span>\n            <span class=\"pb-4\" data-kid=\"1-1-2-2\">\n                Charging Schedule\n            </span>\n            <span class=\"pb-4\" data-kid=\"1-1-2-3\">\n                Simulation / Impact\n            </span>\n            <span class=\"pb-4\" data-kid=\"1-1-2-4\">\n                Alerts\n            </span>\n            <span class=\"pb-4\" data-kid=\"1-1-2-5\">\n                Audit Log\n            </span>\n        </nav>\n    </header>\n    <main class=\"max-w-[1440px] mx-auto px-5 lg:px-10 py-7\" data-kid=\"1-2\">\n        <div class=\"flex flex-wrap justify-between items-center gap-4\" data-kid=\"1-2-1\">\n            <div data-kid=\"1-2-1-1\">\n                <h1 class=\"text-[26px] font-semibold tracking-[-.8px]\" data-kid=\"1-2-1-1-1\">\n                    Command Center\n                </h1>\n                <p class=\"mt-1.5 text-xs text-[#8b9db8]\" data-kid=\"1-2-1-1-2\">\n                    48 hours ahead. Every kilowatt accounted for.\n                </p>\n            </div>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-2\">\n                <span class=\"flex gap-2 items-center text-xs text-[#71d7b2]\" data-kid=\"1-2-1-2-1\">\n                    <i class=\"w-4 h-4\" data-kid=\"1-2-1-2-1-1\" data-lucide=\"shield-check\">\n                    </i>\n                    Safe forecast\n                </span>\n                <button class=\"ml-2 rounded-md bg-[#3b82f6] text-white text-xs font-semibold px-4 py-2.5 flex gap-2 items-center\" data-kid=\"1-2-1-2-2\" type=\"button\">\n                    <i class=\"w-4 h-4\" data-kid=\"1-2-1-2-2-1\" data-lucide=\"play\">\n                    </i>\n                    Plan a simulation\n                </button>\n            </div>\n        </div>\n        <section class=\"mt-7 rounded-lg border border-[#29364b] bg-[#111a28] overflow-hidden\" data-kid=\"1-2-2\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_280px]\" data-kid=\"1-2-2-1\">\n                <div class=\"min-w-0 p-5 sm:p-6 lg:border-r border-[#29364b]\" data-kid=\"1-2-2-1-1\">\n                    <div class=\"flex flex-wrap justify-between gap-3 items-start\" data-kid=\"1-2-2-1-1-1\">\n                        <div data-kid=\"1-2-2-1-1-1-1\">\n                            <h2 class=\"text-[15px] font-semibold\" data-kid=\"1-2-2-1-1-1-1-1\">\n                                48-hour demand forecast\n                            </h2>\n                            <p class=\"text-[11px] mt-1.5 text-[#8c9fbb]\" data-kid=\"1-2-2-1-1-1-1-2\">\n                                Demand and capacity · kW\n                            </p>\n                        </div>\n                        <span class=\"text-[10px] text-[#91a7c8] bg-[#202e44] rounded px-2.5 py-1.5\" data-kid=\"1-2-2-1-1-1-2\">\n                            30 min resolution\n                        </span>\n                    </div>\n                    <div class=\"mt-6 flex flex-wrap gap-5 text-[10px] text-[#9db1cd]\" data-kid=\"1-2-2-1-1-2\">\n                        <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-1-2-1\">\n                            <span class=\"w-4 h-0.5 bg-[#70a8ff]\" data-kid=\"1-2-2-1-1-2-1-1\">\n                            </span>\n                            Forecast demand\n                        </span>\n                        <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-1-2-2\">\n                            <span class=\"w-4 border-t border-dashed border-[#e58d97]\" data-kid=\"1-2-2-1-1-2-2-1\">\n                            </span>\n                            Capacity limit · 2,500 kW\n                        </span>\n                    </div>\n                    <div class=\"h-[325px] mt-5\" data-kid=\"1-2-2-1-1-3\">\n                        <canvas aria-label=\"Forecast demand peaks at 1997.4 kilowatts at T plus 19 hours and T plus 43 hours\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-3-1\" data-name=\"forecast demand chart\" data-reason=\"rendered by chart.js library\" id=\"forecast3\" role=\"img\">\n                        </canvas>\n                    </div>\n                    <div class=\"flex flex-wrap justify-between gap-2 mt-2 text-[10px] text-[#8197b6]\" data-kid=\"1-2-2-1-1-4\">\n                        <span data-kid=\"1-2-2-1-1-4-1\">\n                            Time from forecast start\n                        </span>\n                        <span data-kid=\"1-2-2-1-1-4-2\">\n                            96 forecast intervals\n                        </span>\n                    </div>\n                </div>\n                <aside class=\"p-6 bg-[#131e2c]\" data-kid=\"1-2-2-1-2\">\n                    <div class=\"flex gap-2 items-center text-[11px] text-[#76d6b5]\" data-kid=\"1-2-2-1-2-1\">\n                        <i class=\"w-4 h-4\" data-kid=\"1-2-2-1-2-1-1\" data-lucide=\"shield-check\">\n                        </i>\n                        Within capacity\n                    </div>\n                    <h2 class=\"mt-7 text-xs text-[#a3b3ca]\" data-kid=\"1-2-2-1-2-2\">\n                        Minimum headroom\n                    </h2>\n                    <p class=\"mt-3 text-[47px] leading-none font-medium tracking-[-2px] tabular-nums\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-3\" data-name=\"minimum headroom value\" data-reason=\"updated based on simulation data\">\n                        502.6\n                        <span class=\"text-sm ml-2 text-[#8fa3bf] tracking-normal\" data-kid=\"1-2-2-1-2-3-1\">\n                            kW\n                        </span>\n                    </p>\n                    <p class=\"mt-3 text-xs text-[#76d6b5]\" data-kid=\"1-2-2-1-2-4\">\n                        20.1% remaining at peak\n                    </p>\n                    <div class=\"mt-7 border-t border-[#2b3a50] pt-5\" data-kid=\"1-2-2-1-2-5\">\n                        <div class=\"flex justify-between text-[11px]\" data-kid=\"1-2-2-1-2-5-1\">\n                            <span class=\"text-[#8fa3bf]\" data-kid=\"1-2-2-1-2-5-1-1\">\n                                Peak utilization\n                            </span>\n                            <span class=\"font-['IBM_Plex_Mono']\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-5-1-2\" data-name=\"peak utilization percentage text\" data-reason=\"updated by script\">\n                                79.9%\n                            </span>\n                        </div>\n                        <div class=\"mt-3 h-1.5 rounded bg-[#2b3a50]\" data-kid=\"1-2-2-1-2-5-2\">\n                            <div class=\"w-[79.9%] h-full rounded bg-[#71a7f4]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-5-2-1\" data-name=\"peak utilization progress bar\" data-reason=\"width updated by script based on data\">\n                            </div>\n                        </div>\n                        <div class=\"flex justify-between mt-2 text-[9px] text-[#6f88ac]\" data-kid=\"1-2-2-1-2-5-3\">\n                            <span data-kid=\"1-2-2-1-2-5-3-1\">\n                                0%\n                            </span>\n                            <span data-kid=\"1-2-2-1-2-5-3-2\">\n                                100% capacity\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"mt-7 space-y-4 text-[11px]\" data-kid=\"1-2-2-1-2-6\">\n                        <div class=\"flex justify-between\" data-kid=\"1-2-2-1-2-6-1\">\n                            <span class=\"text-[#8fa3bf]\" data-kid=\"1-2-2-1-2-6-1-1\">\n                                Forecast peak\n                            </span>\n                            <span class=\"font-['IBM_Plex_Mono']\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-6-1-2\" data-name=\"forecast peak value text\" data-reason=\"updated by script\">\n                                1,997.4 kW\n                            </span>\n                        </div>\n                        <div class=\"flex justify-between\" data-kid=\"1-2-2-1-2-6-2\">\n                            <span class=\"text-[#8fa3bf]\" data-kid=\"1-2-2-1-2-6-2-1\">\n                                First peak\n                            </span>\n                            <span class=\"font-['IBM_Plex_Mono']\" data-kid=\"1-2-2-1-2-6-2-2\">\n                                T+19h\n                            </span>\n                        </div>\n                        <div class=\"flex justify-between\" data-kid=\"1-2-2-1-2-6-3\">\n                            <span class=\"text-[#8fa3bf]\" data-kid=\"1-2-2-1-2-6-3-1\">\n                                Second peak\n                            </span>\n                            <span class=\"font-['IBM_Plex_Mono']\" data-kid=\"1-2-2-1-2-6-3-2\">\n                                T+43h\n                            </span>\n                        </div>\n                    </div>\n                </aside>\n            </div>\n            <div class=\"border-t border-[#29364b] px-6 py-3.5 flex flex-wrap items-center gap-2 text-[11px] text-[#a1b2ca]\" data-kid=\"1-2-2-2\">\n                <i class=\"w-4 h-4 text-[#7d95b8]\" data-kid=\"1-2-2-2-1\" data-lucide=\"info\">\n                </i>\n                Baseline forecast only. Run a simulation to evaluate added EV demand and optimized charging.\n            </div>\n        </section>\n        <section aria-label=\"Planning summary\" class=\"grid grid-cols-1 md:grid-cols-3 mt-6 border-y border-[#29364b]\" data-kid=\"1-2-3\">\n            <div class=\"py-5 md:pr-6\" data-kid=\"1-2-3-1\">\n                <h2 class=\"text-[11px] text-[#8fa3bf]\" data-kid=\"1-2-3-1-1\">\n                    Grid capacity\n                </h2>\n                <div class=\"mt-2 flex items-baseline gap-2\" data-kid=\"1-2-3-1-2\">\n                    <span class=\"text-[28px] tracking-[-1px] tabular-nums font-medium\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-1\" data-name=\"grid capacity value\" data-reason=\"updated by script\">\n                        2,500\n                    </span>\n                    <span class=\"text-xs text-[#8fa3bf]\" data-kid=\"1-2-3-1-2-2\">\n                        kW\n                    </span>\n                </div>\n                <p class=\"mt-1 text-[11px] text-[#7189ab]\" data-kid=\"1-2-3-1-3\">\n                    Configured capacity limit\n                </p>\n            </div>\n            <div class=\"py-5 md:px-6 border-y md:border-y-0 md:border-x border-[#29364b]\" data-kid=\"1-2-3-2\">\n                <h2 class=\"text-[11px] text-[#8fa3bf]\" data-kid=\"1-2-3-2-1\">\n                    Average forecast demand\n                </h2>\n                <div class=\"mt-2 flex items-baseline gap-2\" data-kid=\"1-2-3-2-2\">\n                    <span class=\"text-[28px] tracking-[-1px] tabular-nums font-medium\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-1\" data-name=\"average forecast demand value\" data-reason=\"updated by script\">\n                        1,069.8\n                    </span>\n                    <span class=\"text-xs text-[#8fa3bf]\" data-kid=\"1-2-3-2-2-2\">\n                        kW\n                    </span>\n                </div>\n                <p class=\"mt-1 text-[11px] text-[#7189ab]\" data-kid=\"1-2-3-2-3\">\n                    Across the 48-hour outlook\n                </p>\n            </div>\n            <div class=\"py-5 md:pl-6\" data-kid=\"1-2-3-3\">\n                <div class=\"flex justify-between items-center\" data-kid=\"1-2-3-3-1\">\n                    <h2 class=\"text-[11px] text-[#8fa3bf]\" data-kid=\"1-2-3-3-1-1\">\n                        EVs in simulation\n                    </h2>\n                    <span class=\"text-[9px] text-[#a0b1c9] border border-[#34435c] rounded px-2 py-1\" data-kid=\"1-2-3-3-1-2\">\n                        Not run\n                    </span>\n                </div>\n                <div class=\"mt-2 flex items-baseline gap-2\" data-kid=\"1-2-3-3-2\">\n                    <span class=\"text-[28px] tracking-[-1px] font-medium text-[#91a2bc]\" data-kid=\"1-2-3-3-2-1\">\n                        —\n                    </span>\n                    <span class=\"text-xs text-[#8fa3bf]\" data-kid=\"1-2-3-3-2-2\">\n                        EVs\n                    </span>\n                </div>\n                <p class=\"mt-1 text-[11px] text-[#7189ab]\" data-kid=\"1-2-3-3-3\">\n                    Vehicle count appears after a simulation\n                </p>\n            </div>\n        </section>\n        <div class=\"flex flex-wrap justify-between items-center gap-4 pt-5\" data-kid=\"1-2-4\">\n            <span class=\"text-[11px] text-[#91a4c0]\" data-kid=\"1-2-4-1\">\n                Ready to test the impact of more EVs or added solar?\n            </span>\n            <span class=\"text-[11px] text-[#91bcff] flex gap-2 items-center\" data-kid=\"1-2-4-2\">\n                Explore Simulation / Impact\n                <i class=\"w-4 h-4\" data-kid=\"1-2-4-2-1\" data-lucide=\"arrow-right\">\n                </i>\n            </span>\n        </div>\n        <footer class=\"text-[10px] text-[#637b9f] flex flex-wrap gap-2 justify-between mt-7\" data-kid=\"1-2-5\">\n            <span data-kid=\"1-2-5-1\">\n                SmartCharge · Forecast preview\n            </span>\n            <span data-kid=\"1-2-5-2\">\n                Planning data · Not live vehicle telemetry\n            </span>\n        </footer>\n    </main>\n</div>\n<script>\n    lucide.createIcons({attrs:{'stroke-width':1.7,width:18,height:18,color:'currentColor'}});const daily=[401.8,405.1,415.7,448.3,532.1,700.3,950.1,1203.4,1337.4,1288.5,1114,933.4,828.8,819.4,902.7,1083.6,1356.8,1671.2,1922,1997.4,1849.6,1529.8,1154,830.2];const vals=[...daily,...daily].flatMap(x=>[x,x]);new Chart(document.getElementById('forecast3'),{type:'line',data:{labels:vals.map((_,i)=>i/2),datasets:[{label:'Forecast demand',data:vals,borderColor:'#70a8ff',backgroundColor:'rgba(90,152,250,.10)',fill:true,borderWidth:2,pointRadius:c=>[38,86].includes(c.dataIndex)?4:0,pointBackgroundColor:'#a7c8ff',pointHoverRadius:5,tension:.15},{label:'Grid capacity',data:vals.map(()=>2500),borderColor:'#e58d97',borderWidth:1,borderDash:[6,5],pointRadius:0}]},options:{responsive:true,maintainAspectRatio:false,animation:false,interaction:{intersect:false,mode:'index'},plugins:{legend:{display:false},tooltip:{backgroundColor:'#273850',padding:12,callbacks:{title:items=>'T+'+items[0].label+'h',label:item=>item.dataset.label+': '+item.raw+' kW'}}},scales:{x:{grid:{display:false},border:{color:'#2a3a52'},ticks:{color:'#8198ba',maxTicksLimit:9,font:{size:10,family:'Inter'},callback:function(v){return 'T+'+this.getLabelForValue(v)+'h';}}},y:{min:0,max:2800,grid:{color:'#26354a'},border:{display:false},ticks:{stepSize:500,color:'#8198ba',font:{size:10,family:'Inter'}}}}});\n</script>\n",
      "comments": [],
