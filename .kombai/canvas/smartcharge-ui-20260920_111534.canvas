      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;550;600;650;700&display=swap');\n</style>\n<script src=\"https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js\">\n</script>\n<div class=\"min-h-[940px] bg-[#0b0f19] text-[#eef2f8] font-['Inter'] antialiased\" data-kid=\"1\">\n    <header class=\"border-b border-[#232c3c] px-5 lg:px-10 bg-[#0e1420]\" data-kid=\"1-1\">\n        <div class=\"flex min-h-20 items-center justify-between gap-5 flex-wrap py-4 lg:py-0\" data-kid=\"1-1-1\">\n            <div class=\"flex items-center gap-2.5 text-xl font-semibold tracking-[-0.6px]\" data-kid=\"1-1-1-1\">\n                <span class=\"text-blue-400\" data-kid=\"1-1-1-1-1\">\n                    <i class=\"w-6 h-6\" data-kid=\"1-1-1-1-1-1\" data-lucide=\"zap\">\n                    </i>\n                </span>\n                SmartCharge\n            </div>\n            <nav aria-label=\"Main navigation\" class=\"hidden lg:flex items-center gap-1 text-[12px] font-medium text-[#9aa8bd]\" data-kid=\"1-1-1-2\">\n                <span class=\"flex items-center gap-2 rounded-lg bg-[#1d2b44] px-4 py-2.5 text-[#accaff]\" data-kid=\"1-1-1-2-1\">\n                    <i class=\"w-4 h-4\" data-kid=\"1-1-1-2-1-1\" data-lucide=\"activity\">\n                    </i>\n                    Command Center\n                </span>\n                <span class=\"px-3 py-2\" data-kid=\"1-1-1-2-2\">\n                    Charging Schedule\n                </span>\n                <span class=\"px-3 py-2\" data-kid=\"1-1-1-2-3\">\n                    Simulation / Impact\n                </span>\n                <span class=\"px-3 py-2\" data-kid=\"1-1-1-2-4\">\n                    Alerts\n                </span>\n                <span class=\"px-3 py-2\" data-kid=\"1-1-1-2-5\">\n                    Audit Log\n                </span>\n            </nav>\n            <div class=\"flex items-center gap-2 text-xs text-[#9aa8bd]\" data-kid=\"1-1-1-3\">\n                <i class=\"w-4 h-4\" data-kid=\"1-1-1-3-1\" data-lucide=\"layers\">\n                </i>\n                Planning workspace\n            </div>\n        </div>\n        <div class=\"lg:hidden flex flex-wrap gap-x-5 gap-y-3 pb-4 text-xs text-[#a4b3ca]\" data-kid=\"1-1-2\">\n            <span class=\"text-blue-300\" data-kid=\"1-1-2-1\">\n                Command Center\n            </span>\n            <span data-kid=\"1-1-2-2\">\n                Charging Schedule\n            </span>\n            <span data-kid=\"1-1-2-3\">\n                Simulation / Impact\n            </span>\n            <span data-kid=\"1-1-2-4\">\n                Alerts\n            </span>\n            <span data-kid=\"1-1-2-5\">\n                Audit Log\n            </span>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1440px] px-5 py-8 lg:px-10\" data-kid=\"1-2\">\n        <div class=\"flex flex-wrap gap-5 items-center justify-between mb-7\" data-kid=\"1-2-1\">\n            <div data-kid=\"1-2-1-1\">\n                <div class=\"text-[11px] uppercase tracking-[.14em] text-[#8191aa] mb-2\" data-kid=\"1-2-1-1-1\">\n                    Grid operations\n                </div>\n                <h1 class=\"text-[29px] leading-tight tracking-[-1px] font-semibold\" data-kid=\"1-2-1-1-2\">\n                    Command Center\n                </h1>\n                <p class=\"mt-2 text-[13px] text-[#95a4ba]\" data-kid=\"1-2-1-1-3\">\n                    Your grid outlook, before the next charging decision.\n                </p>\n            </div>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-2\">\n                <span class=\"hidden sm:block text-xs text-[#8191aa]\" data-kid=\"1-2-1-2-1\">\n                    Baseline forecast\n                </span>\n                <button class=\"flex items-center gap-2 rounded-lg bg-[#3b82f6] px-4 py-3 text-[12px] font-semibold text-white\" data-kid=\"1-2-1-2-2\" type=\"button\">\n                    <i class=\"w-4 h-4\" data-kid=\"1-2-1-2-2-1\" data-lucide=\"play\">\n                    </i>\n                    Plan a simulation\n                </button>\n            </div>\n        </div>\n        <section aria-label=\"Grid metrics\" class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\" data-kid=\"1-2-2\">\n            <div class=\"rounded-xl border border-[#293d46] bg-[#101f25] p-5\" data-kid=\"1-2-2-1\">\n                <div class=\"flex justify-between items-center\" data-kid=\"1-2-2-1-1\">\n                    <h2 class=\"text-xs text-[#a3bac1]\" data-kid=\"1-2-2-1-1-1\">\n                        Available headroom\n                    </h2>\n                    <i class=\"w-4 h-4 text-[#4ed6ae]\" data-kid=\"1-2-2-1-1-2\" data-lucide=\"shield-check\">\n                    </i>\n                </div>\n                <p class=\"mt-4 text-[34px] font-semibold tracking-[-1.5px] tabular-nums\" data-kid=\"1-2-2-1-2\" data-name=\"available headroom value text\">\n                    502.6\n                    <span class=\"text-sm font-normal tracking-normal text-[#97acb5]\" data-kid=\"1-2-2-1-2-1\">\n                        kW\n                    </span>\n                </p>\n                <p class=\"mt-2 text-[11px] text-[#5ed9b4]\" data-kid=\"1-2-2-1-3\">\n                    20.1% of capacity remains at peak\n                </p>\n            </div>\n            <div class=\"rounded-xl border border-[#253044] bg-[#121a28] p-5\" data-kid=\"1-2-2-2\">\n                <h2 class=\"text-xs text-[#a0aec2]\" data-kid=\"1-2-2-2-1\">\n                    Forecast peak load\n                </h2>\n                <p class=\"mt-4 text-[34px] font-semibold tracking-[-1.5px] tabular-nums\" data-kid=\"1-2-2-2-2\" data-name=\"forecast peak load value text\">\n                    1,997.4\n                    <span class=\"text-sm font-normal tracking-normal text-[#8b9cb4]\" data-kid=\"1-2-2-2-2-1\">\n                        kW\n                    </span>\n                </p>\n                <p class=\"mt-2 text-[11px] text-[#8b9cb4]\" data-kid=\"1-2-2-2-3\">\n                    First peak at T+19h\n                </p>\n            </div>\n            <div class=\"rounded-xl border border-[#253044] bg-[#121a28] p-5\" data-kid=\"1-2-2-3\">\n                <h2 class=\"text-xs text-[#a0aec2]\" data-kid=\"1-2-2-3-1\">\n                    Grid capacity\n                </h2>\n                <p class=\"mt-4 text-[34px] font-semibold tracking-[-1.5px] tabular-nums\" data-kid=\"1-2-2-3-2\" data-name=\"grid capacity value text\">\n                    2,500\n                    <span class=\"text-sm font-normal tracking-normal text-[#8b9cb4]\" data-kid=\"1-2-2-3-2-1\">\n                        kW\n                    </span>\n                </p>\n                <div class=\"mt-3 h-1 rounded-full bg-[#293549]\" data-kid=\"1-2-2-3-3\">\n                    <div class=\"h-1 w-[79.9%] rounded-full bg-[#679ff9]\" data-kid=\"1-2-2-3-3-1\" data-name=\"grid capacity progress bar fill\">\n                    </div>\n                </div>\n                <p class=\"mt-2 text-[11px] text-[#8b9cb4]\" data-kid=\"1-2-2-3-4\">\n                    79.9% utilized at forecast peak\n                </p>\n            </div>\n            <div class=\"rounded-xl border border-[#253044] bg-[#121a28] p-5\" data-kid=\"1-2-2-4\">\n                <h2 class=\"text-xs text-[#a0aec2]\" data-kid=\"1-2-2-4-1\">\n                    EVs in simulation\n                </h2>\n                <p class=\"mt-4 text-[34px] font-semibold tracking-[-1.5px] text-[#a9b5c8]\" data-kid=\"1-2-2-4-2\" data-name=\"evs in simulation value text\">\n                    —\n                    <span class=\"text-sm font-normal tracking-normal text-[#8b9cb4]\" data-kid=\"1-2-2-4-2-1\">\n                        EVs\n                    </span>\n                </p>\n                <p class=\"mt-2 text-[11px] text-[#8b9cb4]\" data-kid=\"1-2-2-4-3\">\n                    No simulation run yet\n                </p>\n            </div>\n        </section>\n        <section class=\"mt-6 rounded-xl border border-[#253044] bg-[#111925] overflow-hidden\" data-kid=\"1-2-3\">\n            <div class=\"flex flex-wrap items-center justify-between gap-4 px-6 pt-6\" data-kid=\"1-2-3-1\">\n                <div data-kid=\"1-2-3-1-1\">\n                    <h2 class=\"text-base font-semibold tracking-[-.3px]\" data-kid=\"1-2-3-1-1-1\">\n                        48-hour demand forecast\n                    </h2>\n                    <p class=\"text-xs mt-1.5 text-[#8b9cb4]\" data-kid=\"1-2-3-1-1-2\">\n                        Baseline demand relative to the grid’s capacity limit\n                    </p>\n                </div>\n                <div class=\"flex gap-5 text-[11px] text-[#a5b2c7]\" data-kid=\"1-2-3-1-2\">\n                    <span class=\"flex items-center gap-2\" data-kid=\"1-2-3-1-2-1\">\n                        <span class=\"w-5 h-0.5 bg-[#6ba5ff]\" data-kid=\"1-2-3-1-2-1-1\">\n                        </span>\n                        Forecast demand\n                    </span>\n                    <span class=\"flex items-center gap-2\" data-kid=\"1-2-3-1-2-2\">\n                        <span class=\"w-5 border-t border-dashed border-[#ed838a]\" data-kid=\"1-2-3-1-2-2-1\">\n                        </span>\n                        Grid capacity\n                    </span>\n                </div>\n            </div>\n            <div class=\"px-6 mt-6 flex items-center justify-between\" data-kid=\"1-2-3-2\">\n                <span class=\"text-[10px] font-medium text-[#8394ac]\" data-kid=\"1-2-3-2-1\">\n                    DEMAND · kW\n                </span>\n                <span class=\"text-[10px] text-[#8394ac]\" data-kid=\"1-2-3-2-2\">\n                    96 intervals · 30 min each\n                </span>\n            </div>\n            <div class=\"h-[300px] sm:h-[330px] px-4 mt-3\" data-kid=\"1-2-3-3\">\n                <canvas aria-label=\"48-hour baseline forecast; peak 1,997.4 kilowatts, below 2,500 kilowatt capacity\" data-dynamic=\"true\" data-kid=\"1-2-3-3-1\" data-name=\"demand forecast line chart\" data-reason=\"rendered and managed by Chart.js library\" id=\"forecast1\" role=\"img\">\n                </canvas>\n            </div>\n            <div class=\"flex flex-wrap items-center justify-between gap-2 text-[11px] text-[#8c9eb8] px-6 pb-5\" data-kid=\"1-2-3-4\">\n                <span data-kid=\"1-2-3-4-1\">\n                    Time from forecast start\n                </span>\n                <span data-kid=\"1-2-3-4-2\">\n                    Peak windows:\n                    <span class=\"text-[#cad6e8]\" data-kid=\"1-2-3-4-2-1\" data-name=\"peak window time stamps\">\n                        T+19h & T+43h\n                    </span>\n                </span>\n            </div>\n            <div class=\"border-t border-[#253044] bg-[#111e24] px-6 py-4 flex flex-wrap gap-3 justify-between text-xs\" data-kid=\"1-2-3-5\">\n                <span class=\"flex gap-2 items-center text-[#66dbb6]\" data-kid=\"1-2-3-5-1\">\n                    <i class=\"w-4 h-4\" data-kid=\"1-2-3-5-1-1\" data-lucide=\"shield-check\">\n                    </i>\n                    <strong class=\"font-medium\" data-kid=\"1-2-3-5-1-2\" data-name=\"grid status message\">\n                        Safe · Forecast remains within capacity\n                    </strong>\n                </span>\n                <span class=\"text-[#95aaaF]\" data-kid=\"1-2-3-5-2\" data-name=\"minimum headroom value\">\n                    502.6 kW minimum headroom\n                </span>\n            </div>\n        </section>\n        <section class=\"mt-5 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-[#253044] p-5 bg-[#101724]\" data-kid=\"1-2-4\">\n            <div class=\"flex items-start gap-3\" data-kid=\"1-2-4-1\">\n                <span class=\"text-[#8195b5] mt-0.5\" data-kid=\"1-2-4-1-1\">\n                    <i class=\"w-5 h-5\" data-kid=\"1-2-4-1-1-1\" data-lucide=\"git-compare-arrows\">\n                    </i>\n                </span>\n                <div data-kid=\"1-2-4-1-2\">\n                    <h2 class=\"text-[13px] font-medium\" data-kid=\"1-2-4-1-2-1\">\n                        What happens when EV demand grows?\n                    </h2>\n                    <p class=\"mt-1 text-xs text-[#8b9cb4]\" data-kid=\"1-2-4-1-2-2\">\n                        Run a scenario to compare unmanaged demand with an optimized charging schedule.\n                    </p>\n                </div>\n            </div>\n            <span class=\"text-xs font-medium text-[#8cb6ff] flex gap-2 items-center\" data-kid=\"1-2-4-2\">\n                Explore Simulation / Impact\n                <i class=\"w-4 h-4\" data-kid=\"1-2-4-2-1\" data-lucide=\"arrow-right\">\n                </i>\n            </span>\n        </section>\n        <footer class=\"pt-5 flex flex-wrap gap-2 justify-between text-[10px] text-[#71819b]\" data-kid=\"1-2-5\">\n            <span data-kid=\"1-2-5-1\">\n                SmartCharge · Grid optimization\n            </span>\n            <span data-kid=\"1-2-5-2\">\n                Forecast preview · No live vehicle telemetry\n            </span>\n        </footer>\n    </main>\n</div>\n<script>\n    lucide.createIcons({attrs:{'stroke-width':1.7,width:18,height:18,color:'currentColor'}});const daily=[401.8,405.1,415.7,448.3,532.1,700.3,950.1,1203.4,1337.4,1288.5,1114,933.4,828.8,819.4,902.7,1083.6,1356.8,1671.2,1922,1997.4,1849.6,1529.8,1154,830.2];const vals=[...daily,...daily].flatMap(x=>[x,x]);const ctx=document.getElementById('forecast1').getContext('2d');const grad=ctx.createLinearGradient(0,0,0,310);grad.addColorStop(0,'rgba(71,137,242,.25)');grad.addColorStop(1,'rgba(71,137,242,.015)');new Chart(ctx,{type:'line',data:{labels:vals.map((_,i)=>i/2),datasets:[{label:'Forecast demand',data:vals,borderColor:'#6ba5ff',backgroundColor:grad,fill:true,borderWidth:2,pointRadius:0,pointHoverRadius:4,tension:.18},{label:'Grid capacity',data:vals.map(()=>2500),borderColor:'#ed838a',borderWidth:1.2,borderDash:[5,5],pointRadius:0}]},options:{responsive:true,maintainAspectRatio:false,animation:false,interaction:{intersect:false,mode:'index'},plugins:{legend:{display:false},tooltip:{backgroundColor:'#202d42',padding:12,callbacks:{title:items=>'T+'+items[0].label+'h',label:item=>item.dataset.label+': '+Number(item.raw).toLocaleString()+' kW'}}},layout:{padding:{right:12}},scales:{x:{grid:{display:false},border:{color:'#2a3548'},ticks:{color:'#8495b0',maxTicksLimit:9,font:{size:10,family:'Inter'},callback:function(v){return 'T+'+this.getLabelForValue(v)+'h';}}},y:{min:0,max:2800,grid:{color:'#223044'},border:{display:false},ticks:{stepSize:500,color:'#8495b0',font:{size:10,family:'Inter'}}}}});\n</script>\n",
