      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;550;600;650;700&family=IBM+Plex+Mono:wght@400;500&display=swap');\n</style>\n<script src=\"https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js\">\n</script>\n<div class=\"min-h-[940px] bg-[#0b0f19] text-[#edf2f9] font-['Inter'] flex antialiased\" data-kid=\"1\">\n    <aside class=\"hidden lg:flex w-[208px] shrink-0 bg-[#101621] border-r border-[#252e3d] flex-col px-4 py-7\" data-kid=\"1-1\">\n        <div class=\"flex items-center gap-2 px-2 text-[21px] font-semibold tracking-[-.8px]\" data-kid=\"1-1-1\">\n            <i class=\"w-6 h-6 text-[#629fff]\" data-kid=\"1-1-1-1\" data-lucide=\"zap\">\n            </i>\n            SmartCharge\n        </div>\n        <p class=\"mt-2 ml-10 text-[10px] text-[#7889a1]\" data-kid=\"1-1-2\">\n            GRID OPTIMIZATION\n        </p>\n        <div class=\"mt-12 px-3 mb-3 text-[10px] text-[#697c97] font-medium tracking-widest\" data-kid=\"1-1-3\">\n            WORKSPACE\n        </div>\n        <nav aria-label=\"Main navigation\" class=\"space-y-1.5 text-[12px] text-[#97a6bc]\" data-kid=\"1-1-4\">\n            <span class=\"flex items-center gap-3 rounded-md bg-[#1d2e49] text-[#afccff] px-3 py-3\" data-kid=\"1-1-4-1\">\n                <i class=\"w-4 h-4\" data-kid=\"1-1-4-1-1\" data-lucide=\"activity\">\n                </i>\n                Command Center\n            </span>\n            <span class=\"flex items-center gap-3 px-3 py-3\" data-kid=\"1-1-4-2\">\n                <i class=\"w-4 h-4\" data-kid=\"1-1-4-2-1\" data-lucide=\"calendar-days\">\n                </i>\n                Charging Schedule\n            </span>\n            <span class=\"flex items-center gap-3 px-3 py-3\" data-kid=\"1-1-4-3\">\n                <i class=\"w-4 h-4\" data-kid=\"1-1-4-3-1\" data-lucide=\"git-compare-arrows\">\n                </i>\n                Simulation / Impact\n            </span>\n            <span class=\"flex items-center gap-3 px-3 py-3\" data-kid=\"1-1-4-4\">\n                <i class=\"w-4 h-4\" data-kid=\"1-1-4-4-1\" data-lucide=\"circle-alert\">\n                </i>\n                Alerts\n            </span>\n            <span class=\"flex items-center gap-3 px-3 py-3\" data-kid=\"1-1-4-5\">\n                <i class=\"w-4 h-4\" data-kid=\"1-1-4-5-1\" data-lucide=\"clipboard-list\">\n                </i>\n                Audit Log\n            </span>\n        </nav>\n        <div class=\"mt-auto pt-20\" data-kid=\"1-1-5\">\n            <div class=\"border-t border-[#252e3d] px-3 pt-5 text-xs text-[#9aaac0]\" data-kid=\"1-1-5-1\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-1-5-1-1\">\n                    <i class=\"w-4 h-4\" data-kid=\"1-1-5-1-1-1\" data-lucide=\"layers\">\n                    </i>\n                    Planning workspace\n                </div>\n                <p class=\"text-[10px] mt-2 leading-relaxed text-[#6f819d]\" data-kid=\"1-1-5-1-2\">\n                    Forecast & simulation data.\n                    <br data-kid=\"1-1-5-1-2-1\"/>\n                    Not live vehicle telemetry.\n                </p>\n            </div>\n        </div>\n    </aside>\n    <div class=\"min-w-0 flex-1\" data-kid=\"1-2\">\n        <header class=\"min-h-[66px] border-b border-[#252e3d] px-5 lg:px-8 flex flex-wrap gap-3 items-center justify-between py-4\" data-kid=\"1-2-1\">\n            <div class=\"text-xs text-[#7e90aa]\" data-kid=\"1-2-1-1\">\n                <span class=\"lg:hidden font-semibold text-[#d8e4f5] mr-4\" data-kid=\"1-2-1-1-1\">\n                    SmartCharge\n                </span>\n                Workspace\n                <span class=\"px-2 text-[#4c5d78]\" data-kid=\"1-2-1-1-2\">\n                    /\n                </span>\n                <span class=\"text-[#bccadd]\" data-kid=\"1-2-1-1-3\">\n                    Command Center\n                </span>\n            </div>\n            <div class=\"flex items-center gap-2 text-[11px] text-[#a9bbd3]\" data-kid=\"1-2-1-2\">\n                <i class=\"w-3.5 h-3.5 text-[#72a6f7]\" data-kid=\"1-2-1-2-1\" data-lucide=\"chart-no-axes-combined\">\n                </i>\n                Baseline forecast\n            </div>\n        </header>\n        <div class=\"lg:hidden px-5 py-4 flex flex-wrap gap-4 text-xs text-[#8fa7c7] border-b border-[#252e3d]\" data-kid=\"1-2-2\">\n            <span data-kid=\"1-2-2-1\">\n                Command Center\n            </span>\n            <span data-kid=\"1-2-2-2\">\n                Charging Schedule\n            </span>\n            <span data-kid=\"1-2-2-3\">\n                Simulation / Impact\n            </span>\n            <span data-kid=\"1-2-2-4\">\n                Alerts\n            </span>\n            <span data-kid=\"1-2-2-5\">\n                Audit Log\n            </span>\n        </div>\n        <main class=\"px-5 lg:px-8 pt-7 pb-6\" data-kid=\"1-2-3\">\n            <div class=\"flex flex-wrap gap-4 items-center justify-between\" data-kid=\"1-2-3-1\">\n                <div data-kid=\"1-2-3-1-1\">\n                    <h1 class=\"text-[27px] font-semibold tracking-[-.8px]\" data-kid=\"1-2-3-1-1-1\">\n                        Command Center\n                    </h1>\n                    <p class=\"mt-1.5 text-xs text-[#8c9cb4]\" data-kid=\"1-2-3-1-1-2\">\n                        A clear view of grid capacity and charging readiness.\n                    </p>\n                </div>\n                <button class=\"flex gap-2 items-center bg-[#3b82f6] text-white px-4 py-2.5 rounded-md text-xs font-semibold\" data-kid=\"1-2-3-1-2\" type=\"button\">\n                    <i class=\"w-4 h-4\" data-kid=\"1-2-3-1-2-1\" data-lucide=\"play\">\n                    </i>\n                    Plan a simulation\n                </button>\n            </div>\n            <div class=\"mt-6 flex flex-wrap items-center justify-between gap-3 border border-[#244138] bg-[#10221e] rounded-lg px-4 py-3\" data-kid=\"1-2-3-2\">\n                <span class=\"flex items-center gap-2.5 text-xs text-[#75dbb7]\" data-kid=\"1-2-3-2-1\">\n                    <i class=\"w-4 h-4\" data-kid=\"1-2-3-2-1-1\" data-lucide=\"shield-check\">\n                    </i>\n                    <strong class=\"font-medium\" data-kid=\"1-2-3-2-1-2\">\n                        Safe\n                    </strong>\n                    <span class=\"text-[#94b7a8]\" data-kid=\"1-2-3-2-1-3\">\n                        Forecast demand stays below grid capacity.\n                    </span>\n                </span>\n                <span class=\"text-[11px] text-[#94b7a8]\" data-kid=\"1-2-3-2-2\">\n                    Next 48 hours\n                </span>\n            </div>\n            <div class=\"grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_262px] gap-5 mt-5\" data-kid=\"1-2-3-3\">\n                <div class=\"min-w-0\" data-kid=\"1-2-3-3-1\">\n                    <section class=\"rounded-lg border border-[#273247] bg-[#111a28] overflow-hidden\" data-kid=\"1-2-3-3-1-1\">\n                        <div class=\"p-5 flex flex-wrap gap-5 justify-between items-start\" data-kid=\"1-2-3-3-1-1-1\">\n                            <div data-kid=\"1-2-3-3-1-1-1-1\">\n                                <h2 class=\"text-sm font-semibold\" data-kid=\"1-2-3-3-1-1-1-1-1\">\n                                    Demand outlook\n                                </h2>\n                                <p class=\"text-[11px] text-[#8b9eb9] mt-1.5\" data-kid=\"1-2-3-3-1-1-1-1-2\">\n                                    48-hour baseline · 30-minute intervals\n                                </p>\n                            </div>\n                            <span class=\"text-[10px] rounded border border-[#33415a] px-2 py-1 text-[#a8b9d0]\" data-kid=\"1-2-3-3-1-1-1-2\">\n                                kW\n                            </span>\n                        </div>\n                        <div class=\"px-5 flex gap-6\" data-kid=\"1-2-3-3-1-1-2\">\n                            <div data-kid=\"1-2-3-3-1-1-2-1\">\n                                <p class=\"text-[10px] text-[#8b9eb9]\" data-kid=\"1-2-3-3-1-1-2-1-1\">\n                                    Forecast peak\n                                </p>\n                                <p class=\"font-['IBM_Plex_Mono'] text-2xl mt-1 tracking-[-1px]\" data-kid=\"1-2-3-3-1-1-2-1-2\">\n                                    1,997.4\n                                    <span class=\"text-xs text-[#8194af]\" data-kid=\"1-2-3-3-1-1-2-1-2-1\">\n                                        kW\n                                    </span>\n                                </p>\n                            </div>\n                            <div class=\"border-l border-[#29364b] pl-6\" data-kid=\"1-2-3-3-1-1-2-2\">\n                                <p class=\"text-[10px] text-[#8b9eb9]\" data-kid=\"1-2-3-3-1-1-2-2-1\">\n                                    Grid capacity\n                                </p>\n                                <p class=\"font-['IBM_Plex_Mono'] text-2xl mt-1 text-[#b6c2d4] tracking-[-1px]\" data-kid=\"1-2-3-3-1-1-2-2-2\">\n                                    2,500\n                                    <span class=\"text-xs text-[#8194af]\" data-kid=\"1-2-3-3-1-1-2-2-2-1\" data-name=\"grid capacity unit text\">\n                                        kW\n                                    </span>\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"h-[320px] px-3 mt-5\" data-kid=\"1-2-3-3-1-1-3\">\n                            <canvas aria-label=\"Demand forecast remains below 2500 kilowatts over 48 hours\" data-dynamic=\"true\" data-kid=\"1-2-3-3-1-1-3-1\" data-name=\"demand forecast chart\" data-reason=\"canvas chart rendered and updated by Chart.js script\" id=\"forecast2\" role=\"img\">\n                            </canvas>\n                        </div>\n                        <div class=\"px-5 pb-5 flex flex-wrap justify-between gap-3 text-[10px] text-[#8ea2bf]\" data-kid=\"1-2-3-3-1-1-4\">\n                            <span class=\"flex gap-4\" data-kid=\"1-2-3-3-1-1-4-1\">\n                                <span class=\"flex items-center gap-1.5\" data-kid=\"1-2-3-3-1-1-4-1-1\">\n                                    <b class=\"w-3 h-0.5 bg-[#6da6ff]\" data-kid=\"1-2-3-3-1-1-4-1-1-1\">\n                                    </b>\n                                    Demand\n                                </span>\n                                <span class=\"flex items-center gap-1.5\" data-kid=\"1-2-3-3-1-1-4-1-2\">\n                                    <b class=\"w-3 border-t border-dashed border-[#f08c93]\" data-kid=\"1-2-3-3-1-1-4-1-2-1\">\n                                    </b>\n                                    Capacity\n                                </span>\n                            </span>\n                            <span data-kid=\"1-2-3-3-1-1-4-2\">\n                                Hours from forecast start\n                            </span>\n                        </div>\n                    </section>\n                    <section class=\"mt-5 rounded-lg border border-[#273247] overflow-hidden\" data-kid=\"1-2-3-3-1-2\">\n                        <div class=\"px-5 py-4 bg-[#111a28] flex flex-wrap gap-2 justify-between\" data-kid=\"1-2-3-3-1-2-1\">\n                            <h2 class=\"text-xs font-semibold\" data-kid=\"1-2-3-3-1-2-1-1\">\n                                Forecast checkpoints\n                            </h2>\n                            <span class=\"text-[10px] text-[#8598b4]\" data-kid=\"1-2-3-3-1-2-1-2\">\n                                First 24 hours\n                            </span>\n                        </div>\n                        <div class=\"overflow-x-auto\" data-kid=\"1-2-3-3-1-2-2\">\n                            <table class=\"w-full text-left text-[11px]\" data-kid=\"1-2-3-3-1-2-2-1\">\n                                <thead class=\"bg-[#0e1623] text-[#8598b4]\" data-kid=\"1-2-3-3-1-2-2-1-1\">\n                                    <tr data-kid=\"1-2-3-3-1-2-2-1-1-1\">\n                                        <th class=\"font-normal px-5 py-2.5\" data-kid=\"1-2-3-3-1-2-2-1-1-1-1\">\n                                            Window\n                                        </th>\n                                        <th class=\"font-normal py-2.5\" data-kid=\"1-2-3-3-1-2-2-1-1-1-2\">\n                                            Demand\n                                        </th>\n                                        <th class=\"font-normal py-2.5 pr-5 text-right\" data-kid=\"1-2-3-3-1-2-2-1-1-1-3\">\n                                            Headroom\n                                        </th>\n                                    </tr>\n                                </thead>\n                                <tbody class=\"text-[#c1cddd]\" data-kid=\"1-2-3-3-1-2-2-1-2\">\n                                    <tr class=\"border-t border-[#202d40]\" data-kid=\"1-2-3-3-1-2-2-1-2-1\">\n                                        <td class=\"px-5 py-3\" data-kid=\"1-2-3-3-1-2-2-1-2-1-1\">\n                                            T+8h · First rise\n                                        </td>\n                                        <td class=\"font-['IBM_Plex_Mono']\" data-kid=\"1-2-3-3-1-2-2-1-2-1-2\">\n                                            1,337.4 kW\n                                        </td>\n                                        <td class=\"text-right pr-5 text-[#84bbab] font-['IBM_Plex_Mono']\" data-kid=\"1-2-3-3-1-2-2-1-2-1-3\">\n                                            1,162.6 kW\n                                        </td>\n                                    </tr>\n                                    <tr class=\"border-t border-[#202d40] bg-[#131e30]\" data-kid=\"1-2-3-3-1-2-2-1-2-2\">\n                                        <td class=\"px-5 py-3 text-[#9bc1ff]\" data-kid=\"1-2-3-3-1-2-2-1-2-2-1\">\n                                            T+19h · Forecast peak\n                                        </td>\n                                        <td class=\"font-['IBM_Plex_Mono']\" data-kid=\"1-2-3-3-1-2-2-1-2-2-2\">\n                                            1,997.4 kW\n                                        </td>\n                                        <td class=\"text-right pr-5 text-[#84bbab] font-['IBM_Plex_Mono']\" data-kid=\"1-2-3-3-1-2-2-1-2-2-3\">\n                                            502.6 kW\n                                        </td>\n                                    </tr>\n                                </tbody>\n                            </table>\n                        </div>\n                    </section>\n                </div>\n                <aside class=\"space-y-5\" data-kid=\"1-2-3-3-2\">\n                    <section class=\"rounded-lg border border-[#2b403f] bg-[#111f24] p-5\" data-kid=\"1-2-3-3-2-1\">\n                        <div class=\"flex justify-between items-center\" data-kid=\"1-2-3-3-2-1-1\">\n                            <h2 class=\"text-xs text-[#a0babd]\" data-kid=\"1-2-3-3-2-1-1-1\">\n                                Capacity headroom\n                            </h2>\n                            <i class=\"w-4 h-4 text-[#6bcdb0]\" data-kid=\"1-2-3-3-2-1-1-2\" data-lucide=\"shield-check\">\n                            </i>\n                        </div>\n                        <p class=\"mt-5 font-['IBM_Plex_Mono'] text-[39px] leading-none tracking-[-2px]\" data-kid=\"1-2-3-3-2-1-2\">\n                            502.6\n                            <span class=\"text-xs ml-2 text-[#8caaaF] tracking-normal\" data-kid=\"1-2-3-3-2-1-2-1\" data-name=\"headroom unit text\">\n                                kW\n                            </span>\n                        </p>\n                        <p class=\"text-[11px] mt-3 text-[#70d6b1]\" data-kid=\"1-2-3-3-2-1-3\">\n                            20.1% available at peak\n                        </p>\n                        <div class=\"h-2 mt-7 flex gap-1\" data-kid=\"1-2-3-3-2-1-4\">\n                            <div class=\"w-[79.9%] rounded-l bg-[#6099eb]\" data-kid=\"1-2-3-3-2-1-4-1\">\n                            </div>\n                            <div class=\"flex-1 rounded-r bg-[#4aae8f]\" data-kid=\"1-2-3-3-2-1-4-2\">\n                            </div>\n                        </div>\n                        <div class=\"flex justify-between text-[10px] text-[#8da5b3] mt-2\" data-kid=\"1-2-3-3-2-1-5\">\n                            <span data-kid=\"1-2-3-3-2-1-5-1\">\n                                79.9% utilized\n                            </span>\n                            <span data-kid=\"1-2-3-3-2-1-5-2\">\n                                20.1% spare\n                            </span>\n                        </div>\n                        <div class=\"border-t border-[#2b403f] mt-6 pt-4 text-[11px] leading-relaxed text-[#97adb6]\" data-kid=\"1-2-3-3-2-1-6\">\n                            Headroom is the difference between grid capacity and forecast peak demand.\n                        </div>\n                    </section>\n                    <section class=\"rounded-lg border border-[#273247] bg-[#111a28] p-5\" data-kid=\"1-2-3-3-2-2\">\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-2-3-3-2-2-1\">\n                            <h2 class=\"text-xs font-medium\" data-kid=\"1-2-3-3-2-2-1-1\">\n                                EV simulation\n                            </h2>\n                            <i class=\"w-4 h-4 text-[#7d9dc6]\" data-kid=\"1-2-3-3-2-2-1-2\" data-lucide=\"plug-zap\">\n                            </i>\n                        </div>\n                        <div class=\"mt-5 flex justify-between items-end\" data-kid=\"1-2-3-3-2-2-2\">\n                            <span class=\"text-[11px] text-[#8b9eb9]\" data-kid=\"1-2-3-3-2-2-2-1\">\n                                EVs in scenario\n                            </span>\n                            <span class=\"text-2xl text-[#93a3bb]\" data-dynamic=\"true\" data-kid=\"1-2-3-3-2-2-2-2\" data-name=\"ev scenario count text\" data-reason=\"text value managed by simulation status script\">\n                                —\n                            </span>\n                        </div>\n                        <div class=\"mt-3 text-[10px] inline-block rounded bg-[#243045] text-[#a9b9d0] px-2 py-1\" data-dynamic=\"true\" data-kid=\"1-2-3-3-2-2-3\" data-name=\"simulation status badge\" data-reason=\"text value managed by simulation status script\">\n                            Not run\n                        </div>\n                        <p class=\"mt-4 text-[11px] leading-[1.8] text-[#8b9eb9]\" data-kid=\"1-2-3-3-2-2-4\">\n                            Run a simulation to see EV demand, peak reduction, and an optimized charging schedule.\n                        </p>\n                        <span class=\"mt-5 flex items-center justify-between text-[11px] text-[#8dbaff]\" data-kid=\"1-2-3-3-2-2-5\">\n                            Open Simulation / Impact\n                            <i class=\"w-4 h-4\" data-kid=\"1-2-3-3-2-2-5-1\" data-lucide=\"arrow-up-right\">\n                            </i>\n                        </span>\n                    </section>\n                </aside>\n            </div>\n            <footer class=\"mt-5 text-[10px] text-[#687c98] flex justify-between gap-3\" data-kid=\"1-2-3-4\">\n                <span data-kid=\"1-2-3-4-1\">\n                    SmartCharge · Planning workspace\n                </span>\n                <span data-kid=\"1-2-3-4-2\">\n                    Forecast preview\n                </span>\n            </footer>\n        </main>\n    </div>\n</div>\n<script>\n    lucide.createIcons({attrs:{'stroke-width':1.7,width:18,height:18,color:'currentColor'}});const daily=[401.8,405.1,415.7,448.3,532.1,700.3,950.1,1203.4,1337.4,1288.5,1114,933.4,828.8,819.4,902.7,1083.6,1356.8,1671.2,1922,1997.4,1849.6,1529.8,1154,830.2];const vals=[...daily,...daily].flatMap(x=>[x,x]);new Chart(document.getElementById('forecast2'),{type:'line',data:{labels:vals.map((_,i)=>i/2),datasets:[{label:'Demand',data:vals,borderColor:'#6da6ff',backgroundColor:'rgba(69,128,222,.12)',fill:true,borderWidth:2,pointRadius:0,pointHoverRadius:4,tension:.15},{label:'Capacity',data:vals.map(()=>2500),borderColor:'#f08c93',borderWidth:1,borderDash:[5,5],pointRadius:0}]},options:{responsive:true,maintainAspectRatio:false,animation:false,interaction:{intersect:false,mode:'index'},plugins:{legend:{display:false},tooltip:{backgroundColor:'#24334b',callbacks:{title:items=>'T+'+items[0].label+'h',label:item=>item.dataset.label+': '+item.raw+' kW'}}},scales:{x:{grid:{display:false},border:{color:'#29364b'},ticks:{color:'#7c91ae',maxTicksLimit:7,font:{size:10,family:'IBM Plex Mono'},callback:function(v){return '+'+this.getLabelForValue(v)+'h';}}},y:{min:0,max:2800,grid:{color:'#243045'},border:{display:false},ticks:{stepSize:500,color:'#7c91ae',font:{size:10,family:'IBM Plex Mono'}}}}});\n</script>\n",
